<UserControl x:Class="AgentBridge.Desktop.AndroidSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{StaticResource AgentBridgeBackgroundBrush}"
             Foreground="{StaticResource AgentBridgeTextBrush}">
    <Grid Margin="24,22,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Android"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AgentBridgeTextBrush}" />
                <TextBlock Text="Pair Wireless debugging, connect ADB, and run the isolated Android MCP agent."
                           Margin="0,4,0,0"
                           FontSize="13"
                           Foreground="{StaticResource AgentBridgeMutedBrush}" />
            </StackPanel>
            <Border x:Name="OverallStatusBorder"
                    Grid.Column="1"
                    Background="#D97706"
                    CornerRadius="3"
                    Padding="12,6"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="OverallStatusDot" Width="8" Height="8" Fill="White" Margin="0,0,7,0" />
                    <TextBlock x:Name="OverallStatusText"
                               Text="Checking ADB"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <ui:InfoBar x:Name="FeedbackInfoBar"
                    Grid.Row="2"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Informational" />

        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{StaticResource AgentBridgeSurfaceBrush}"
                        BorderBrush="{StaticResource AgentBridgeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="17">
                    <StackPanel>
                        <TextBlock Text="1. Prepare the phone"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AgentBridgeTextBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource AgentBridgeMutedBrush}"
                                   FontSize="12.5">
                            <Run Text="On the phone: enable Developer options → USB debugging → USB debugging (Security settings). Reboot once if Xiaomi asks, then enable Wireless debugging. Keep the phone unlocked and on the same Wi-Fi as this computer." />
                        </TextBlock>
                        <TextBlock Margin="0,7,0,0"
                                   Text="Open “Pair device with pairing code” to obtain the pairing port and 6-digit code. The connection port is shown on the main Wireless debugging screen."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource AgentBridgeSubtleBrush}"
                                   FontSize="11.5" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Background="{StaticResource AgentBridgeSurfaceBrush}"
                        BorderBrush="{StaticResource AgentBridgeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="17">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="2. ADB and wireless connection"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AgentBridgeTextBrush}" />
                                <TextBlock Text="Pairing code is never saved. IP and ports are saved locally so they can be monitored and refreshed."
                                           Margin="0,3,0,0"
                                           FontSize="11.5"
                                           Foreground="{StaticResource AgentBridgeMutedBrush}" />
                            </StackPanel>
                            <ui:Button x:Name="RefreshButton"
                                       Grid.Column="1"
                                       Content="Detect &amp; refresh"
                                       Icon="{ui:SymbolIcon ArrowSync16}"
                                       Appearance="Transparent"
                                       Click="Refresh_Click" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" SharedSizeGroup="AndroidLabels" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ADB path" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox x:Name="AdbPathTextBox"
                                     Grid.Column="1"
                                     AutomationProperties.AutomationId="AndroidAdbPathTextBox" />
                            <ui:Button Grid.Column="3"
                                       Content="Browse"
                                       Icon="{ui:SymbolIcon FolderOpenVertical16}"
                                       Appearance="Secondary"
                                       Click="BrowseAdb_Click" />
                        </Grid>

                        <Grid Margin="0,10,0,0" Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" SharedSizeGroup="AndroidLabels" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Phone IPv4" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox x:Name="DeviceIpTextBox"
                                     Grid.Column="1"
                                     MaxLength="45"
                                     ToolTip="Example: 192.168.1.8"
                                     AutomationProperties.AutomationId="AndroidDeviceIpTextBox" />
                            <TextBlock Grid.Column="3" Text="Pairing port" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox x:Name="PairingPortTextBox"
                                     Grid.Column="4"
                                     MaxLength="5"
                                     ToolTip="Port shown inside Pair device with pairing code"
                                     AutomationProperties.AutomationId="AndroidPairingPortTextBox" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Pairing code" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <PasswordBox x:Name="PairingCodeBox"
                                         Grid.Column="1"
                                         MaxLength="6"
                                         ToolTip="6-digit one-time code; it is not saved"
                                         AutomationProperties.AutomationId="AndroidPairingCodeBox" />
                            <TextBlock Grid.Column="3" Text="Connection port" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox x:Name="ConnectionPortTextBox"
                                     Grid.Column="4"
                                     MaxLength="5"
                                     ToolTip="Port shown on the main Wireless debugging screen"
                                     AutomationProperties.AutomationId="AndroidConnectionPortTextBox" />
                        </Grid>

                        <WrapPanel Margin="0,14,0,0" Orientation="Horizontal">
                            <ui:Button x:Name="PairButton"
                                       Content="Pair phone"
                                       Appearance="Primary"
                                       Background="{StaticResource AgentBridgeAccentBrush}"
                                       Foreground="White"
                                       BorderBrush="{StaticResource AgentBridgeAccentBrush}"
                                       Margin="0,0,8,8"
                                       Click="Pair_Click" />
                            <ui:Button x:Name="ConnectButton"
                                       Content="Connect ADB"
                                       Appearance="Primary"
                                       Margin="0,0,8,8"
                                       Click="Connect_Click" />
                            <ui:Button x:Name="DisconnectButton"
                                       Content="Disconnect"
                                       Appearance="Secondary"
                                       Margin="0,0,8,8"
                                       Click="Disconnect_Click" />
                            <ui:Button x:Name="SaveButton"
                                       Content="Save settings"
                                       Icon="{ui:SymbolIcon Save16}"
                                       Appearance="Transparent"
                                       Margin="0,0,8,8"
                                       Click="Save_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Background="{StaticResource AgentBridgeSurfaceBrush}"
                        BorderBrush="{StaticResource AgentBridgeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="17">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Connection status"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AdbStatusText"
                                       Text="ADB: checking…"
                                       Margin="0,10,0,0"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DeviceStatusText"
                                       Text="Phone: not checked"
                                       Margin="0,7,0,0"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DeviceDetailText"
                                       Text="No device details yet."
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource AgentBridgeMutedBrush}"
                                       FontSize="11.5" />
                            <TextBlock x:Name="DebugFlagsText"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource AgentBridgeSubtleBrush}"
                                       FontSize="11" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Android MCP agent"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AgentStatusText"
                                       Text="Stopped"
                                       Margin="0,10,0,0"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Dedicated endpoint: /mcp/android/a"
                                       Margin="0,6,0,0"
                                       FontFamily="Consolas, Cascadia Code, monospace"
                                       Foreground="{StaticResource AgentBridgeMutedBrush}"
                                       FontSize="11.5" />
                            <TextBlock Text="This process is separate from the Windows agent and does not change /mcp/a or /mcp/b."
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource AgentBridgeSubtleBrush}"
                                       FontSize="11" />
                            <WrapPanel Margin="0,12,0,0">
                                <ui:Button x:Name="StartAgentButton"
                                           Content="Start / Restart agent"
                                           Appearance="Primary"
                                           Margin="0,0,8,8"
                                           Click="StartAgent_Click" />
                                <ui:Button x:Name="StopAgentButton"
                                           Content="Stop agent"
                                           Appearance="Secondary"
                                           Margin="0,0,8,8"
                                           Click="StopAgent_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ConfigPathText"
                       Foreground="{StaticResource AgentBridgeSubtleBrush}"
                       FontSize="10.5"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Text="Connection ports may change after reboot; use Detect &amp; refresh."
                       Foreground="{StaticResource AgentBridgeWarningBrush}"
                       FontSize="10.5" />
        </Grid>
    </Grid>
</UserControl>

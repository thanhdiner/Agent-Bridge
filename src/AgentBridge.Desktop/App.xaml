<Application x:Class="AgentBridge.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AgentBridgeBackgroundBrush" Color="#151515" />
            <SolidColorBrush x:Key="AgentBridgeSidebarBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AgentBridgeSurfaceBrush" Color="#202020" />
            <SolidColorBrush x:Key="AgentBridgeBorderBrush" Color="#333333" />
            <SolidColorBrush x:Key="AgentBridgeAccentBrush" Color="#F47C20" />
            <SolidColorBrush x:Key="AgentBridgeAccentSoftBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AgentBridgeTextBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="AgentBridgeMutedBrush" Color="#A3A3A3" />
            <SolidColorBrush x:Key="AgentBridgeSubtleBrush" Color="#737373" />
            <SolidColorBrush x:Key="AgentBridgeSuccessBrush" Color="#6EE7A8" />
            <SolidColorBrush x:Key="AgentBridgeWarningBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="AgentBridgeDangerBrush" Color="#FF6B7A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
